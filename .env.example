# Names only. Copy to .env and fill in. Never commit real values.
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
# any long random string; signs confirm cards and login cookies. Required when DUKAAN_DB_FILE is set.
PROPOSAL_SECRET=
# path of the database file, for example .data/ledger.sqlite. Set it to run your own shop with a login.
DUKAAN_DB_FILE=
# the WhatsApp service in services/wa-userauth (login codes and sending reminders)
WA_SERVICE_URL=
WA_APP_KEY=
WA_APP_SECRET=
NEXT_PUBLIC_APP_URL=
DEMO_SHOP_ID=
# your shop's UPI id, offered as the default at setup
DEMO_UPI_VPA=
